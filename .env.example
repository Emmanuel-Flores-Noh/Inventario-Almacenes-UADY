# Plantilla de variables de entorno para docker compose.
#
# Uso: copia este archivo a .env y reemplaza los marcadores por valores reales.
#   cp .env.example .env        (Linux/macOS)
#   Copy-Item .env.example .env (PowerShell)
#
# .env esta en .gitignore: nunca se versiona. Las contrasenas de esta plantilla
# son marcadores, no credenciales reales.

# --- MariaDB ---
# Obligatorias: docker compose falla si no se definen.
DB_ROOT_PASSWORD=cambia_esta_contrasena_de_root
DB_PASSWORD=cambia_esta_contrasena_del_usuario
DB_NAME=almacenes_uady
DB_USER=uady_user
DB_HOST=mariadb
DB_PORT=3306

# --- Broker ---
# BROKER_PORT debe coincidir con el mapeo de puertos de docker-compose.yml.
BROKER_PORT=5000
BROKER_POOL_SIZE=16
BROKER_TIMEOUT_CONEXION_MS=2000
BROKER_TIMEOUT_LECTURA_MS=5000
BROKER_REINTENTOS=2
BROKER_ESPERA_REINTENTO_MS=200
BROKER_FALLOS_PARA_INDISPONIBLE=3
BROKER_INDISPONIBLE_MS=30000

# --- Sistema 1 (Sistema Centralizado / Proveedor) ---
# SERVICE_PORT debe coincidir con el mapeo de puertos de docker-compose.yml.
SERVICE_PORT=6000
# Host con el que el proveedor se anuncia al broker dentro de la red de Docker.
SERVICE_HOST=sistema-centralizado
SERVICE_POOL_SIZE=16
REGISTRO_INTENTOS=30
REGISTRO_ESPERA_MS=2000
BROKER_HOST=broker
# Carpeta de los PNG de los QR. En Docker siempre es /app/storage/qr (volumen qr_storage);
# solo se define al ejecutar la interfaz desde el IDE, p. ej. QR_DIR=storage/qr.
# QR_DIR=
